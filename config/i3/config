set $mod Mod4

font pango:TerminessNerdFontMono 11

exec --no-startup-id mullvad-vpn
exec_always --no-startup-id sleep 1 && xinput --set-prop "6" "libinput Accel Speed" -0.4
exec --no-startup-id picom
exec --no-startup-id sleep 1 && redshift
exec --no-startup-id dunst
exec --no-startup-id feh --bg-fill Pictures/wallpapers/space.jpg
# exec_always --no-startup-id .local/bin/fehbg.sh 5m
exec --no-startup-id systemctl --user start clipmenud

# bindsym $mod+Shift+q exec pkill -f fehbg.sh, exec pkill -f redshift, exit
bindsym $mod+Shift+q exec pkill -f redshift, exit

set $refresh_i3status killall -SIGUSR1 i3status
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +5% && $refresh_i3status
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -5% && $refresh_i3status
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle && $refresh_i3status
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle && $refresh_i3status
bindsym XF86MonBrightnessUp exec --no-startup-id brightnessctl set +10% && $refresh_i3status
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl set 10%- && $refresh_i3status

floating_modifier $mod

tiling_drag modifier titlebar

bindsym $mod+Return exec alacritty -o font.size=10
bindsym $mod+b exec librewolf
bindsym $mod+e exec pcmanfm
bindsym $mod+z exec whatsdesk
bindsym $mod+x exec spotify
bindsym $mod+n exec thunderbird

bindsym $mod+Ctrl+m exec mullvad connect
bindsym $mod+Ctrl+n exec mullvad disconnect

bindsym $mod+Shift+a exec librewolf /usr/share/doc/arch-wiki/html/en/

bindsym $mod+q kill

bindsym $mod+space exec --no-startup-id dmenu_run -fn "TerminessNerdFontMono:pixelsize=16"
bindsym $mod+u exec --no-startup-id passmenu
bindsym $mod+Shift+u exec --no-startup-id networkmanager_dmenu
bindsym $mod+c exec --no-startup-id clipmenu

bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right
bindsym $mod+h focus left

bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right
bindsym $mod+Shift+h move left

bindsym $mod+i split h 
bindsym $mod+o split v

bindsym $mod+m fullscreen toggle

bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+Shift+w layout toggle split

bindsym $mod+t floating toggle
bindsym $mod+Shift+t focus mode_toggle

bindsym $mod+v exec --no-startup-id maim --select --hidecursor "$HOME/Pictures/$(date).png"
bindsym $mod+Shift+v exec --no-startup-id maim --select --hidecursor | xclip -selection clipboard -t image/png

set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

assign [class="whatsdesk"] $ws3
assign [class="spotify"] $ws3
assign [class="thunderbird"] $ws3

bindsym $mod+Shift+c reload
# bindsym $mod+Shift+r exec pkill -f fehbg.sh, restart
bindsym $mod+Shift+r restart
bindsym $mod+p exec /home/eu/.local/bin/lock_and_blur.sh

mode "resize" {
  bindsym l resize grow width 10 px or 10 ppt
  bindsym h resize shrink width 10 px or 10 ppt
  bindsym j resize grow height 10 px or 10 ppt
  bindsym k resize shrink height 10 px or 10 ppt

  bindsym Return mode "default"
  bindsym Escape mode "default"
  bindsym $mod+r mode "default"
}

bindsym $mod+r mode "resize"

bar {
  position bottom
  # strip_workspace_numbers yes
  tray_output primary

  status_command i3status --config $HOME/.config/i3/statusbar.conf | $HOME/.config/i3/i3bar_extensions.sh
}
